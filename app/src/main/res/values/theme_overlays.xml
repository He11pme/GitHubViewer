<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="ThemeOverlay.GitHubViewer.AppBarLayout" parent="">

        <!--    colorPrimary: color background      -->
        <item name="colorPrimary">@color/foreground</item>

    </style>

    <style name="ThemeOverlay.GitHubViewer.TextInputLayout" parent="ThemeOverlay.Material3.TextInputEditText.OutlinedBox">

        <!--    colorPrimary: color stroke when focus      -->
        <item name="colorPrimary">@color/stroke_text_input_layout</item>

    </style>

    <style name="ThemeOverlay.GitHubViewer.Button" parent="ThemeOverlay.Material3.Button.ElevatedButton">

        <!--    colorOnContainer: color text      -->
        <item name="colorOnContainer">@color/text_button</item>
        <item name="colorContainer">@color/background_button</item>

    </style>

</resources>