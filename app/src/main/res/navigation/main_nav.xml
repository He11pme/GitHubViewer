<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav"
    app:startDestination="@id/authFragment">

    <fragment
        android:id="@+id/authFragment"
        android:name="ivan.mineev.githubviewer.fragments.auth.AuthFragment"
        android:label="fragment_auth"
        tools:layout="@layout/fragment_auth" >
        <action
            android:id="@+id/navigateFromAuthFragmentToRepositoriesListFragment"
            app:destination="@id/repositoriesListFragment"
            app:popUpTo="@id/authFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/repositoriesListFragment"
        android:name="ivan.mineev.githubviewer.fragments.repos.RepositoriesListFragment"
        android:label="Repositories"
        tools:layout="@layout/fragment_repositories_list">
        <action
            android:id="@+id/navigateFromRepositoriesListFragmentToDetailInfoFragment"
            app:destination="@id/detailInfoFragment" />
        <action
            android:id="@+id/navigateFromRepositoriesListFragmentToAuthFragment"
            app:destination="@id/authFragment" />
    </fragment>
    <fragment
        android:id="@+id/detailInfoFragment"
        android:name="ivan.mineev.githubviewer.fragments.info.RepositoryInfoFragment"
        android:label=""
        tools:layout="@layout/fragment_detail_info" >
        <action
            android:id="@+id/navigateFromDetailInfoFragmentToRepositoriesListFragment"
            app:destination="@id/repositoriesListFragment" />
        <argument
            android:name="nameRepo"
            app:argType="string" />
    </fragment>
</navigation>